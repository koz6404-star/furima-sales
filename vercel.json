{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/import-excel/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/amazon-sync/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/amazon-sync/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/amazon-sync",
      "schedule": "0 18 * * *"
    }
  ]
}
