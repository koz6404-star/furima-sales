# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# マイグレーション実行用（npm run supabase-migrate）
# 方法1: 完全な接続文字列（Connect モーダルの Session pooler URI をコピー）
# SUPABASE_DB_URL=postgresql://postgres.プロジェクトID:パスワード@aws-X-リージョン.pooler.supabase.com:5432/postgres
#
# 方法2: パスワードのみ（supabase link 済みなら pooler-url から自動構築）
# SUPABASE_DB_PASSWORD=your_database_password
